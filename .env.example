# ───────────────────────── VoxMesh server ─────────────────────────
API_PORT=8787
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# Shared secret for external worker agents calling /api/tasks/:id/claim|complete (x-agent-key header)
AGENT_API_KEY=change-me-dev-agent-key
# Require a verified human (World ID session) to start workflows. Agent registration always requires one.
WORKFLOW_REQUIRES_HUMAN=false
# Runtime bounds
MAX_AGENT_CALLS_PER_WORKFLOW=6
MAX_DELEGATION_DEPTH=2
AGENT_TASK_TIMEOUT_MS=90000
AGENT_MAX_RETRIES=2

# ───────────────────────── 0G inference ─────────────────────────
# auto = use 0G when ZG_API_KEY is set, otherwise the clearly labelled mock adapter
INFERENCE_MODE=auto
ZG_API_KEY=
# Mainnet: https://router-api.0g.ai/v1   Testnet: https://router-api-testnet.integratenetwork.work/v1
ZG_BASE_URL=https://router-api.0g.ai/v1
ZG_MODEL=glm-5.2
# Optional: "private" routes to TeeML enclaves (X-0G-Provider-Trust-Mode header)
ZG_TRUST_MODE=
# Ask the router to synchronously verify the provider's TEE signature (adds tee_verified to responses)
ZG_VERIFY_TEE=true
# Disable GLM "thinking" for faster structured output
ZG_DISABLE_THINKING=true
ZG_TIMEOUT_MS=60000

# ───────────────────────── Arkiv ─────────────────────────
# auto = use Arkiv when ARKIV_PRIVATE_KEY is set, otherwise the clearly labelled in-memory dev store
ARKIV_MODE=auto
# Free key: https://hub.arkiv.network/access-keys (empty = heavily rate-limited public endpoint)
ARKIV_ACCESS_KEY=
# Funded Rabdi testnet key (faucet: https://hub.arkiv.network/faucet). Never sent to the LLM or client.
ARKIV_PRIVATE_KEY=
# Namespace attribute so this deployment's entities are isolated on the shared testnet
ARKIV_WORKSPACE=voxmesh-ethglobal-mumbai
ARKIV_TASK_TTL_HOURS=24
ARKIV_AGENT_TTL_DAYS=7

# ───────────────────────── World ID (IDKit v4) ─────────────────────────
# From https://developer.world.org — app + RP configuration
WORLD_APP_ID=
WORLD_RP_ID=
# RP signing key (hex). Server-side only.
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=authorize-voxmesh-agents
# production | staging | sandbox (staging works with the World ID simulator)
WORLD_ENVIRONMENT=production
WORLD_VERIFY_BASE_URL=https://developer.worldcoin.org/api/v4/verify
# DEV ONLY: allows a mock "verification" that is labelled dev-bypass everywhere. Never enable in production.
WORLD_ID_DEV_BYPASS=false
IDENTITY_SESSION_TTL_MINUTES=60

# ───────────────────────── Frontend (Vite) ─────────────────────────
# Leave empty to use the Vite dev proxy (/api → http://localhost:8787)
VITE_API_URL=
